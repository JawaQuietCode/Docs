# .env.example — template; `bash start.sh` menyalin dan memandu setup pertama kali.
# JANGAN pernah commit `.env` (isinya kunci rahasia). File ini hanya contoh.
#
# Semua nilai di bawah dibaca oleh DUA sisi:
#   - transport Node  (transport/env.js → config.js)
#   - inti agent Python (agent/config.py → _load_env)
# process.env asli selalu menang atas isi file ini.

# ─── LLM (gateway OpenAI-compatible) ──────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Model cadangan, dipisah koma. Dipakai bila model utama ditolak gateway
# (mis. `model_param_invalid`) — dulu satu model rusak = bot mati.
LLM_FALLBACK_MODELS=
# Model VISION (multimodal) untuk membaca gambar, dipisah koma. HARUS model yang
# benar-benar bisa melihat gambar; kalau kosong, dipakai model utama lalu cadangan.
LLM_VISION_MODELS=
# true (default) = pakai streaming SSE; otomatis kembali ke non-stream bila
# gateway menolaknya.
LLM_STREAM=true
# Percobaan ulang untuk 429/5xx/gangguan jaringan.
LLM_RETRY_MAX=4
# Jarak minimum antar request provider (detik); 10 = satu request per 10 detik.
LLM_REQUEST_INTERVAL_SECONDS=10
# Sisi terpanjang gambar sebelum dikirim ke model (piksel).
LLM_VISION_MAX_PX=1568

# ─── OWNER ────────────────────────────────────────────────────────────────────
# Nomor WhatsApp yang boleh menyuruh bot, dipisah koma (format 628xxx).
# Owner PERTAMA = owner utama, kecuali WA_PRIMARY_OWNER diisi.
WA_OWNER_NUMBERS=
WA_PRIMARY_OWNER=

# ─── MEKANISME (engine) ───────────────────────────────────────────────────────
# native (bawaan) | hermes | claude | codex. Mekanisme eksternal hanya dipakai
# bila CLI-nya ada di PATH; kalau tidak, otomatis jatuh ke native.
DEFAULT_MECHANISM=native
# Mekanisme per owner: 628xxx=claude,628yyy=codex
OWNER_MECHANISMS=

# RTK CLI output optimization; set 0 to skip optional RTK installation/use.
KWEE_RTK=1

# ─── INTI AGENT ───────────────────────────────────────────────────────────────
AGENT_HOST=127.0.0.1
AGENT_PORT=8787

# ─── TOKEN TRANSPORT ↔ INTI AGENT (WAJIB) ─────────────────────────────────────
# Dipakai sebagai header `X-Agent-Token` pada setiap request transport → agent.
# Tanpa token, siapa pun di localhost bisa memanggil /message sebagai owner.
# start.sh/setup.sh membuat nilainya otomatis bila masih kosong.
# Buat manual: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACTION_TOKEN=

# ─── AKSI WHATSAPP (kirim pesan/media dari sisi Node) ─────────────────────────
ACTION_HOST=127.0.0.1
ACTION_PORT=8790

# ─── PAIRING WHATSAPP (opsional) ──────────────────────────────────────────────
WA_PAIRING_NUMBER=
WA_PAIRING_CODE=

# ─── PTERODACTYL (opsional, tool panel) ───────────────────────────────────────
# Kosongkan bila tidak dipakai. Kunci ini TIDAK pernah masuk konteks LLM.
PTERO_API_URL=
PTERO_API_KEY=
PTERO_DEFAULT_NODE=
PTERO_DEFAULT_NEST=
PTERO_DEFAULT_EGG=
PTERO_DEFAULT_USER=
PTERO_DEFAULT_DOCKER_IMAGE=
PTERO_DEFAULT_STARTUP=
PTERO_DEFAULT_MEMORY=1024
PTERO_DEFAULT_DISK=3072
PTERO_DEFAULT_CPU=100

# ── Akses berkas (mode owner) ────────────────────────────────────────────────
# Default: bot boleh mengirim berkas dari path mana pun (panel, /tmp, /home).
# Set 0 bila ingin mengurung pengiriman ke root proyek saja.
# KWEE_ALLOW_ANY_PATH=0
# Default: .env dan data/sessions tetap ditolak saat dikirim ke chat.
# Set 1 bila benar-benar ingin mengirim berkas rahasia itu.
# KWEE_ALLOW_SECRET_FILES=1

# ── Engine OpenHands (bawaan) ────────────────────────────────────────────────
# OpenHands Canvas adalah engine opsional; runtime native menjadi default.
# Set 1 atau jalankan `bash start.sh --canvas` untuk memasangnya.
KWEE_CANVAS=0

# Optional public HTTPS/WSS endpoint for live AFK cards (reverse proxy to agent /ws/afk).
KWEE_AFK_PUBLIC_URL=
KWEE_AFK_WS_URL=
# Optional separate secret; falls back to ACTION_TOKEN.
KWEE_AFK_WS_SECRET=

# ── INTELLIGENCE LAYER (optional) ───────────────────────────────────────────
# Enable Mem0 semantic memory only after Qdrant is running and provider config
# in config/default.yaml is correct. Local FTS5/room memory works without it.
KWEE_MEM0_ENABLED=false
MEM0_QDRANT_HOST=127.0.0.1
MEM0_QDRANT_PORT=6333
# Mem0's OpenAI provider reads OPENAI_API_KEY from the environment. Use a
# dedicated key; this is separate from LLM_API_KEY unless you choose otherwise.
OPENAI_API_KEY=
# GitHub MCP uses a FRESH, least-privilege fine-grained token. Never paste it
# into config/default.yaml or source files. Store it here or in your secret store.
GITHUB_PERSONAL_ACCESS_TOKEN=
